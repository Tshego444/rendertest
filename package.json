{
  "name": "jobseekr-monorepo",
  "private": true,
  "scripts": {
    "start-backend": "node Backend/server.js",
    "dev-backend": "nodemon Backend/server.js",
    "client": "npm run dev --prefix Frontend",
    "dev": "concurrently \"npm run dev-backend\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10"
  }
}
